/// Production model forecasts for every full 2026 local day, rerun across temperature changes (-15 to +15 F, step 5) and sunshine levels (30 to 130 percent of forecast, step 10). Precomputed because Power BI cannot run the scikit-learn models.
table 'What-If Scenarios'
	lineageTag: bea1290f-1e76-54c8-843f-0cfc28d4e85d

	column 'Local Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: f6809bc5-bf3a-5ce6-a353-0e6511b14dbe
		summarizeBy: none
		sourceColumn: Local Date

		annotation SummarizationSetBy = Automatic

	column 'Local Hour'
		dataType: int64
		isHidden
		lineageTag: ec26ffcf-e5d6-5cbe-b3a1-7fc459f62ff4
		summarizeBy: none
		sourceColumn: Local Hour

		annotation SummarizationSetBy = Automatic

	column 'Temperature Change (F)'
		dataType: int64
		formatString: +0;-0;0
		lineageTag: c81c7cfc-2129-5b2a-98dd-5d37f6c78323
		summarizeBy: none
		sourceColumn: Temperature Change (F)

		annotation SummarizationSetBy = Automatic

	column 'Sunshine vs Forecast (%)'
		dataType: int64
		formatString: 0
		lineageTag: 055a3c4a-fb1e-5aaa-ae76-d231f7fc44e9
		summarizeBy: none
		sourceColumn: Sunshine vs Forecast (%)

		annotation SummarizationSetBy = Automatic

	column 'Scenario Demand (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 9c44cafa-b9fa-5d7b-a21f-8da7ecc5ec02
		summarizeBy: none
		sourceColumn: Scenario Demand (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Scenario Renewable (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 99630e18-260c-527e-ad09-c81c45cda88b
		summarizeBy: none
		sourceColumn: Scenario Renewable (MWh)

		annotation SummarizationSetBy = Automatic

	partition 'What-If Scenarios' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "whatif_scenarios_2026.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"local_date", "local_hour", "temp_change_f", "sunshine_pct", "demand_scenario_mwh", "renewable_scenario_mwh"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"local_date", type date}, {"local_hour", Int64.Type}, {"temp_change_f", Int64.Type}, {"sunshine_pct", Int64.Type}, {"demand_scenario_mwh", type number}, {"renewable_scenario_mwh", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"local_date", "Local Date"}, {"local_hour", "Local Hour"}, {"temp_change_f", "Temperature Change (F)"}, {"sunshine_pct", "Sunshine vs Forecast (%)"}, {"demand_scenario_mwh", "Scenario Demand (MWh)"}, {"renewable_scenario_mwh", "Scenario Renewable (MWh)"}})
				in
				    Renamed

