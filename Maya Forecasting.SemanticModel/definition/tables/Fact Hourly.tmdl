		formatString: #,0.0
		lineageTag: d9bbf69a-815e-5d88-ba54-0c52454d11ab
		summarizeBy: none
		sourceColumn: Demand Maya Forecast (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Demand GBM Forecast (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 27a567ec-6631-5bdd-83c1-b7da1cdc15e4
		summarizeBy: none
		sourceColumn: Demand GBM Forecast (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Demand LSTM Forecast (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: e7c39f5e-9c50-54bc-a5f4-ffb93b7b8f87
		summarizeBy: none
		sourceColumn: Demand LSTM Forecast (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Renewable Actual (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 7164cb95-c28d-58e2-b9c2-6caa1e9c6a50
		summarizeBy: none
		sourceColumn: Renewable Actual (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Renewable Maya Forecast (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 43f0740e-81d9-539c-b9ea-f4a6949418db
		summarizeBy: none
		sourceColumn: Renewable Maya Forecast (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Renewable Persistence (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 32bc5334-0c83-5e83-95e6-c03cf7181ec0
		summarizeBy: none
		sourceColumn: Renewable Persistence (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Solar Actual (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 4964a939-6722-536e-aadf-c07fea0e6cb3
		summarizeBy: none
		sourceColumn: Solar Actual (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Net Load Actual (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: dabd1350-5db8-5cff-80d5-22b9cf947a52
		summarizeBy: none
		sourceColumn: Net Load Actual (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Net Load Maya Forecast (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 9802cedb-4a07-5819-961a-6037dc1452c4
		summarizeBy: none
		sourceColumn: Net Load Maya Forecast (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Net Load Baseline (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 46d3b788-ab83-5ef9-9c52-fca5a2ff943c
		summarizeBy: none
		sourceColumn: Net Load Baseline (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Renewable Share Actual (%)'
		dataType: double
		formatString: 0.00
		lineageTag: ceff0654-3174-550f-88c5-a96a1a53027e
