	column 'Local DateTime'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 36cd0c14-14d4-5e26-a7c8-ce5b524538ec
		summarizeBy: none
		sourceColumn: Local DateTime

		annotation SummarizationSetBy = Automatic

	column 'Local Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 894bfc42-8260-5a67-ae0f-d6c767b88c5c
		summarizeBy: none
		sourceColumn: Local Date

		annotation SummarizationSetBy = Automatic

	column 'Local Hour'
		dataType: int64
		isHidden
		lineageTag: 6422155f-89b6-539f-9c9b-20bb7f0c27b2
		summarizeBy: none
		sourceColumn: Local Hour

		annotation SummarizationSetBy = Automatic

	partition 'Fact Hourly' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "final_forecasts_hourly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"timestamp_utc", type datetime}, {"period", type text}, {"Demand Actual (MWh)", type number}, {"Demand PACE Forecast (MWh)", type number}, {"Demand Forecast (MWh)", type number}, {"Demand Forecast GBM (MWh)", type number}, {"Demand Forecast LSTM (MWh)", type number}, {"Renewable Actual (MWh)", type number}, {"Renewable Forecast (MWh)", type number}, {"Renewable Persistence (MWh)", type number}, {"Solar Actual (MWh)", type number}, {"Net Load Actual (MWh)", type number}, {"Net Load Forecast (MWh)", type number}, {"Net Load Baseline (MWh)", type number}, {"Renewable Share Actual (%)", type number}, {"Renewable Share Forecast (%)", type number}, {"Renewable Target Calibration", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"timestamp_utc", "Timestamp UTC"}, {"period", "Period Code"}, {"Demand Forecast (MWh)", "Demand Maya Forecast (MWh)"}, {"Demand Forecast GBM (MWh)", "Demand GBM Forecast (MWh)"}, {"Demand Forecast LSTM (MWh)", "Demand LSTM Forecast (MWh)"}, {"Renewable Forecast (MWh)", "Renewable Maya Forecast (MWh)"}, {"Net Load Forecast (MWh)", "Net Load Maya Forecast (MWh)"}}),
				    ToLocal = (utc as datetime) as datetime =>
				        let
				            y = Date.Year(utc),
				            mar1 = #date(y, 3, 1),
				            nov1 = #date(y, 11, 1),
				            dstStart = DateTime.From(Date.AddDays(mar1, Number.Mod(7 - Date.DayOfWeek(mar1, Day.Sunday), 7) + 7)) + #duration(0, 9, 0, 0),
				            dstEnd = DateTime.From(Date.AddDays(nov1, Number.Mod(7 - Date.DayOfWeek(nov1, Day.Sunday), 7))) + #duration(0, 8, 0, 0),
				            offset = if utc >= dstStart and utc < dstEnd then -6 else -7
				        in
				            utc + #duration(0, offset, 0, 0),
				    AddLocal = Table.AddColumn(Renamed, "Local DateTime", each ToLocal([Timestamp UTC]), type datetime),
				    AddDate = Table.AddColumn(AddLocal, "Local Date", each DateTime.Date([Local DateTime]), type date),
				    AddHour = Table.AddColumn(AddDate, "Local Hour", each Time.Hour([Local DateTime]), Int64.Type)
				in
				    AddHour

