/// One row per hour, Feb 4 2024 to Sep 1 2026 (UTC). Actuals, Maya day-ahead forecasts and baselines. Local time is Mountain time with daylight saving.
table 'Fact Hourly'
	lineageTag: 7ea17432-a5fd-5efc-8080-2c50738cf3f1

	column 'Timestamp UTC'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: b0f5d06a-c6db-54a6-8918-668d5b539a9c
		summarizeBy: none
		sourceColumn: Timestamp UTC

		annotation SummarizationSetBy = Automatic

	column 'Period Code'
		dataType: string
		isHidden
		lineageTag: 361bc25f-4f19-5003-87eb-c89680bf3fcb
		summarizeBy: none
		sourceColumn: Period Code

		annotation SummarizationSetBy = Automatic

	column 'Demand Actual (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: 421dbf7e-54b1-51c5-aace-9498095c1ffd
		summarizeBy: none
		sourceColumn: Demand Actual (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Demand PACE Forecast (MWh)'
		dataType: double
		formatString: #,0.0
		lineageTag: eccc8365-d25a-5371-bb7c-b0de7c49ae65
		summarizeBy: none
		sourceColumn: Demand PACE Forecast (MWh)

		annotation SummarizationSetBy = Automatic

	column 'Demand Maya Forecast (MWh)'
