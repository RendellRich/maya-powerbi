model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Fact Hourly'
ref table Metrics
ref table 'Feature Importance'
ref table 'What-If Scenarios'
ref table 'Dim Date'
ref table 'Dim Hour'
ref table 'Dim Period'
ref table 'Series Selector'
ref table 'Added Solar'
ref table _Measures

ref cultureInfo en-US

